	(text "TPS2121 RUX pinout captured exactly. R0.1 keeps PR1/CP2 as population straps so USB-vs-Dock priority can be changed without a respin." (exclude_from_sim no) (at 25 20 0) (effects (font (size 1.05 1.05)) (justify left bottom)) (uuid "70000000-0000-4000-8000-000000000214"))
	(text "BQ25185: R_ILIM/VSET=18k baseline (4.2V / 500mA input limit), R_ISET=1k baseline (~300mA fast charge). Battery NTC is external through J_BAT pin 3." (exclude_from_sim no) (at 25 25 0) (effects (font (size 1.05 1.05)) (justify left bottom)) (uuid "70000000-0000-4000-8000-000000000215"))
	(text "TPS63802 replaces TPS63031 for first-spin headroom: 2A @ 3.3V for VIN>=2.3V, MODE low for power-save, 0.47uH DFE201612E-R47M=P2, 511k/91k feedback, 10uF input and 2x22uF output." (exclude_from_sim no) (at 25 30 0) (effects (font (size 1.05 1.05)) (justify left bottom)) (uuid "70000000-0000-4000-8000-000000000216"))
	(text "R_MUX_ILIM=100k is a conservative R0.1 placeholder current-limit population; verify simultaneous source and inrush behavior on bench before production freeze." (exclude_from_sim no) (at 25 35 0) (effects (font (size 1.05 1.05)) (justify left bottom)) (uuid "70000000-0000-4000-8000-000000000217"))
